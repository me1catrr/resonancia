# --- Quarto: salidas generadas (se regeneran al compilar) ---
/.quarto/
/_site/
**/*.quarto_ipynb
# NO ignorar _freeze/: guarda los resultados de Julia para publicar sin ejecutarlo

# --- Datos privados: nunca salen de este equipo ---
/datos/privados/
# --- Datos reales sin ordenar: la versión publicable vive en datos/reales-publicables/ ---
/datos/reales/
# --- Paquetes completos para Zenodo: se regeneran, no van a git ---
/datos/zenodo/
# --- Apuntes de consulta: solo locales, nunca se publican ---
/docs/

# --- Python (entorno uv local) ---
.venv/
__pycache__/
*.pyc

# --- Sistema ---
.DS_Store

# --- Claude Code: ajustes personales (los del proyecto sí se versionan) ---
.claude/settings.local.json

/.luarc.json
_capturas/

# Salidas del informe de ejemplo de C6 (se regeneran con quarto render)
claude/c6-informes/_ejemplo/informe/*.html
claude/c6-informes/_ejemplo/informe/*.pdf
claude/c6-informes/_ejemplo/informe/*_files/
claude/c6-informes/_ejemplo/informe/.quarto/
