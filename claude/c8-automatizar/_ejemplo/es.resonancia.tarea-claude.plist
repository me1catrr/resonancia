<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>es.resonancia.tarea-claude</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/ana/proyecto/automatizacion/ejecutar_tarea.sh</string>
    <string>Resume los cambios de ayer en el repositorio</string>
    <string>/Users/ana/proyecto</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/ana/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>REGISTRO</key><string>/Users/ana/proyecto/automatizacion/registro-tarea.log</string>
  </dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>40</integer></dict>
  <key>StandardOutPath</key><string>/Users/ana/proyecto/automatizacion/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/ana/proyecto/automatizacion/launchd.err</string>
</dict>
</plist>
